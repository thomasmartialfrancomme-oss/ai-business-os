# ═══════════════════════════════════════════════════════════════════════════════
#  AI BUSINESS OS — MODÈLE DE CONFIGURATION PRODUCTION
#
#  Mode d'emploi :
#    1. Copiez ce fichier en .env (ou collez son contenu dans les variables
#       d'environnement de votre hébergeur — jamais dans le dépôt Git).
#    2. Remplacez chaque  <<...>>  par votre valeur.
#    3. Lancez : npm run stripe-verify-account
#    Aide détaillée : docs/CHECKLIST-PROPRIETAIRE.md
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Base de données (obligatoire) ─────────────────────────────────────────────
DATABASE_URL="postgresql://<<user>>:<<mot_de_passe>>@<<hote>>:5432/<<base>>?schema=public"

# ─── Application (obligatoire) ─────────────────────────────────────────────────
APP_URL="https://<<votre-domaine>>.com"
# Générer avec : openssl rand -hex 32
APP_SECRET="<<64_caracteres_aleatoires>>"

# ─── Stripe (obligatoire pour encaisser) ───────────────────────────────────────
# Mode TEST d'abord (sk_test_…), puis LIVE (sk_live_…) après la recette complète.
STRIPE_SECRET_KEY="<<sk_test_ou_sk_live>>"
# Secret de l'endpoint de webhook : Stripe → Développeurs → Webhooks → votre endpoint
STRIPE_WEBHOOK_SECRET="<<whsec_...>>"
# Facultatif (le module actuel n'en a pas besoin côté serveur)
STRIPE_PUBLISHABLE_KEY="<<pk_test_ou_pk_live>>"

# En production, la simulation doit rester désactivée (les routes /api/sim/* renvoient 404)
ALLOW_SIMULATION="false"

# ⚠️ IMPORTANT — authentification
# Tant que la connexion de démonstration (src/lib/auth.ts) n'est pas remplacée par
# votre fournisseur d'identité, gardez ceci sur "false" : sinon n'importe qui pourrait
# se connecter en tant que propriétaire de la plateforme.
DEMO_LOGIN="false"

# ─── Catalogue : ID de prix créés par « npm run stripe:setup » ─────────────────
STRIPE_PRICE_ID_STARTER_MONTH="<<price_...>>"
STRIPE_PRICE_ID_STARTER_YEAR="<<price_...>>"
STRIPE_PRICE_ID_PRO_MONTH="<<price_...>>"
STRIPE_PRICE_ID_PRO_YEAR="<<price_...>>"
STRIPE_PRICE_ID_BUSINESS_MONTH="<<price_...>>"
STRIPE_PRICE_ID_BUSINESS_YEAR="<<price_...>>"

# ─── Règles commerciales ───────────────────────────────────────────────────────
ANNUAL_DISCOUNT_PERCENT="20"   # réduction sur les prix annuels (0–90)
PAST_DUE_GRACE_DAYS="3"        # jours d'accès maintenus après un échec de paiement

# ─── RIB n°2 : coordonnées de RÉCEPTION des virements CLIENTS (facultatif) ─────
# ⚠️ Ce n'est PAS le RIB de versement (celui-ci se configure dans Stripe).
#    Ces valeurs peuvent aussi être saisies dans /admin/settings, qui est prioritaire.
BANK_ACCOUNT_HOLDER="<<titulaire_du_compte>>"
BANK_NAME="<<banque_et_agence>>"
BANK_IBAN="<<FR76_...>>"
BANK_BIC="<<BIC>>"
BANK_ADDRESS="<<adresse_de_la_banque>>"
BANK_ROUTING_NOTE="Virement SEPA ou SWIFT. Indiquez impérativement la référence AIB-XXXX-XXXX en libellé."

# ─── Propriétaire de la plateforme ─────────────────────────────────────────────
OWNER_EMAIL="<<votre-email@domaine.com>>"

# ─── Développement / tests uniquement (à NE PAS définir en production) ─────────
# DATABASE_URL_TEST="postgresql://.../aibos_test"
# SIM_DELIVER_VIA_HTTP="false"

# ═══════════════════════════════════════════════════════════════════════════════
#  RAPPEL — Le RIB de VERSEMENT (celui qui reçoit VOTRE argent) ne figure pas ici :
#  il se configure exclusivement dans Stripe → Paramètres → Virements → Compte
#  bancaire, avec la cadence de versement souhaitée. L'application ne stocke
#  aucun IBAN de versement et ne peut pas déclencher de virement.
#
#  Vérification en un coup d'œil de ce que le module verra :
#    • RIB de versement  : Stripe → Paramètres → Virements
#    • RIB de réception  : /admin/settings (ou BANK_* ci-dessus)
#    • Clés secrètes     : uniquement dans ce fichier, jamais côté navigateur
# ═══════════════════════════════════════════════════════════════════════════════
