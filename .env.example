# ═══════════════════════════════════════════════════════════════════════════════
#  AI BUSINESS OS — MODULE PAIEMENT : variables d'environnement
#  Copiez ce fichier en .env puis renseignez vos valeurs.
#  ⚠️ .env ne doit JAMAIS être committé dans un dépôt public.
#  ⚠️ Ces valeurs restent côté serveur : aucune n'est exposée au navigateur.
# ═══════════════════════════════════════════════════════════════════════════════

# --- Base de données (obligatoire) ---
DATABASE_URL="postgresql://user:password@localhost:5432/aibos?schema=public"

# --- Application ---
APP_URL="http://localhost:3000"
# Secret de signature des sessions (≥ 32 caractères aléatoires) : openssl rand -hex 32
APP_SECRET="changez-moi-par-32-caracteres-aleatoires-minimum"

# --- Stripe ---
# MODE SIMULATION  : laissez STRIPE_SECRET_KEY vide (parcours complet sans compte Stripe)
# ENVIRONNEMENT TEST : sk_test_… (+ STRIPE_WEBHOOK_SECRET du `stripe listen`)
# PRODUCTION       : sk_live_… (+ STRIPE_WEBHOOK_SECRET de votre endpoint de production)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# Autorise les routes de simulation : auto (uniquement si aucune clé Stripe), true, false
ALLOW_SIMULATION="auto"

# Connexion de démonstration (choix d'un compte par e-mail, sans mot de passe) :
#   auto  = active hors production, désactivée en production  ← recommandé
#   true  = force l'activation (démonstration privée uniquement, JAMAIS en public)
#   false = toujours désactivée (site réel avec votre fournisseur d'identité)
DEMO_LOGIN="auto"

# --- Catalogue ---
# Réduction appliquée aux prix annuels, en pourcentage (0-90)
ANNUAL_DISCOUNT_PERCENT="20"

# ID de prix Stripe, créés par `npm run stripe:setup`
STRIPE_PRICE_ID_STARTER_MONTH=""
STRIPE_PRICE_ID_STARTER_YEAR=""
STRIPE_PRICE_ID_PRO_MONTH=""
STRIPE_PRICE_ID_PRO_YEAR=""
STRIPE_PRICE_ID_BUSINESS_MONTH=""
STRIPE_PRICE_ID_BUSINESS_YEAR=""

# --- Abonnements ---
# Période de grâce après un échec de paiement avant suspension de l'accès (jours)
PAST_DUE_GRACE_DAYS="3"

# --- Virement bancaire : coordonnées de RÉCEPTION du propriétaire de la plateforme ---
# (modifiables aussi depuis /admin/settings — ce sont des coordonnées de réception,
#  jamais des données de carte)
BANK_ACCOUNT_HOLDER=""
BANK_NAME=""
BANK_IBAN=""
BANK_BIC=""
BANK_ADDRESS=""
BANK_ROUTING_NOTE=""

# --- Propriétaire de la plateforme (facturation / administration) ---
OWNER_EMAIL="owner@votre-domaine.com"
